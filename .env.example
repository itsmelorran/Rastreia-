# Copie este arquivo para .env e ajuste os valores

# Conexao com o PostgreSQL
DATABASE_URL=postgres://rastreia:rastreia@localhost:5432/rastreia

# Porta do servidor web
PORT=3000

# Segredo para assinar os tokens JWT (troque por um valor longo e aleatorio)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES=8h

# Senha do admin criado pelo seed
ADMIN_EMAIL=ana.operadora@central.gov.br
ADMIN_SENHA=123456
