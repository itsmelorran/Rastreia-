{
  "name": "rastreia-plus",
  "version": "1.0.0",
  "description": "Sistema web de apoio a protecao de vitimas de violencia (TCC)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:https": "node src/server.js --https",
    "cert": "node scripts/gerar-certificado.js",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "node db/seed.js",
    "db:setup": "npm run db:schema && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "selfsigned": "^2.4.1"
  }
}
